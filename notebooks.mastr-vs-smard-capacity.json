{"version":3,"kind":"Notebook","sha256":"d79bb9c17cc538e263f6bea13087616ac8276c3375282775c7f53dcb04693f71","slug":"notebooks.mastr-vs-smard-capacity","location":"/notebooks/02_mastr_vs_smard_capacity.ipynb","dependencies":[],"frontmatter":{"title":"MaStR vs. SMARD: installed capacity","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"jupytext":{},"authors":[{"nameParsed":{"literal":"cgroll","family":"cgroll"},"name":"cgroll","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cgroll/energy-insights","copyright":"2026","numbering":{"title":{"offset":1}},"source_url":"https://github.com/cgroll/energy-insights/blob/main/book/notebooks/02_mastr_vs_smard_capacity.ipynb","edit_url":"https://github.com/cgroll/energy-insights/edit/main/book/notebooks/02_mastr_vs_smard_capacity.ipynb","exports":[{"format":"ipynb","filename":"02_mastr_vs_smard_capacity.ipynb","url":"/energy-insights/build/02_mastr_vs_smard_ca-56521a67e841d926dabeeb7aa415fea7.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"The Bundesnetzagentur publishes its own official year-end installed-\ncapacity figures via SMARD, independently of the unit-level MaStR\nregister. Comparing the two is a useful sanity check on the MaStR-derived\nnumbers used throughout the rest of this book -- unlike a one-off,\nhand-copied comparison against a single year’s press release, this reads\nboth sides live from ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qRay9w176G"},{"type":"inlineCode","value":"energy-data-hub","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"gKoctGUXTU"},{"type":"text","value":" so it stays current automatically.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HROSKt8sWm"}],"key":"bt8BkhxBSK"}],"identifier":"ee39e229","html_id":"ee39e229","key":"W3qJbGUXyZ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T04:41:46.067682Z","iopub.status.busy":"2026-09-24T04:41:46.067352Z","iopub.status.idle":"2026-09-24T04:41:46.710778Z","shell.execute_reply":"2026-09-24T04:41:46.709847Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport pandas as pd\n\nfrom insights.paths import hub_file\n\npanel = pd.read_parquet(hub_file(\"capacity\", \"capacity_by_region_year.parquet\"))\n\nTECHNOLOGIES = [\"solar\", \"wind_onshore\", \"wind_offshore\"]\nTECHNOLOGY_LABELS = {\"solar\": \"Solar\", \"wind_onshore\": \"Wind (onshore)\", \"wind_offshore\": \"Wind (offshore)\"}\nTECHNOLOGY_COLORS = {\"solar\": \"#E8A33D\", \"wind_onshore\": \"#1B7A9C\", \"wind_offshore\": \"#8B4A1E\"}","key":"ADy20XsS0c"},{"type":"outputs","id":"9dNTBcEZWSnvIValDVYHO","children":[],"key":"q5kD0UcvOi"}],"identifier":"be11dd47","html_id":"be11dd47","key":"Oq6cZPA0Ua"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"MaStR side: national annual totals","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WvASABPgGw"}],"identifier":"mastr-side-national-annual-totals","label":"MaStR side: national annual totals","html_id":"mastr-side-national-annual-totals","implicit":true,"key":"xhyFasbIu1"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Summed across all regions per year; wind is split into onshore/offshore\nusing the same ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wdiWiaQDu2"},{"type":"inlineCode","value":"DEZZ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ThEZTCZf0l"},{"type":"text","value":" offshore pseudo-region convention used elsewhere in\nthis book. Includes the current (still-incomplete) year -- MaStR’s\n“year-end” snapshot for it is really just “as of today”.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IDohkkgxqZ"}],"key":"Gm3OfIUdlE"}],"identifier":"8cb57a41","html_id":"8cb57a41","key":"uQRhgyYFXB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T04:41:46.713814Z","iopub.status.busy":"2026-09-24T04:41:46.713426Z","iopub.status.idle":"2026-09-24T04:41:46.733871Z","shell.execute_reply":"2026-09-24T04:41:46.732984Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"is_offshore = panel[\"region_code\"].str.startswith(\"DEZZ\")\nmastr_national = pd.DataFrame({\n    \"solar\": panel[panel[\"technology\"] == \"solar\"].groupby(\"year\")[\"capacity_mw\"].sum(),\n    \"wind_onshore\": panel[(panel[\"technology\"] == \"wind\") & ~is_offshore].groupby(\"year\")[\"capacity_mw\"].sum(),\n    \"wind_offshore\": panel[(panel[\"technology\"] == \"wind\") & is_offshore].groupby(\"year\")[\"capacity_mw\"].sum(),\n})\nmastr_national.tail()","key":"nsQQB8VrjB"},{"type":"outputs","id":"UruBfrAGaSeo7iXbNPauZ","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>solar</th>\n      <th>wind_onshore</th>\n      <th>wind_offshore</th>\n    </tr>\n    <tr>\n      <th>year</th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>2022</th>\n      <td>61207.246707</td>\n      <td>57578.912577</td>\n      <td>8216.018</td>\n    </tr>\n    <tr>\n      <th>2023</th>\n      <td>74749.042702</td>\n      <td>60561.224467</td>\n      <td>8473.193</td>\n    </tr>\n    <tr>\n      <th>2024</th>\n      <td>89853.589735</td>\n      <td>63118.485147</td>\n      <td>9215.093</td>\n    </tr>\n    <tr>\n      <th>2025</th>\n      <td>104702.674288</td>\n      <td>67717.724447</td>\n      <td>9733.493</td>\n    </tr>\n    <tr>\n      <th>2026</th>\n      <td>111491.319665</td>\n      <td>69757.710017</td>\n      <td>10855.643</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/plain":{"content":"              solar  wind_onshore  wind_offshore\nyear                                            \n2022   61207.246707  57578.912577       8216.018\n2023   74749.042702  60561.224467       8473.193\n2024   89853.589735  63118.485147       9215.093\n2025  104702.674288  67717.724447       9733.493\n2026  111491.319665  69757.710017      10855.643","content_type":"text/plain"}}},"children":[],"key":"FRQl6987Pn"}],"key":"bWsBaqNdIZ"}],"identifier":"07315ac1","html_id":"07315ac1","key":"XPLIn0tFV4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"SMARD side: official year-end capacity","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Dvs0o1bz5V"}],"identifier":"smard-side-official-year-end-capacity","label":"SMARD side: official year-end capacity","html_id":"smard-side-official-year-end-capacity","implicit":true,"key":"os1ISVkHPK"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"SMARD’s own capacity series are published hourly but only actually change\nvalue a handful of times a year -- effectively a year-end (Dec 31)\nsnapshot repeated forward until the next update, the same cadence as\nMaStR’s annual panel above.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"THyuLTHENb"}],"key":"mktA5JrdJY"}],"identifier":"d6d3b638","html_id":"d6d3b638","key":"g2I8zR7DY1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T04:41:46.735561Z","iopub.status.busy":"2026-09-24T04:41:46.735403Z","iopub.status.idle":"2026-09-24T04:41:46.765683Z","shell.execute_reply":"2026-09-24T04:41:46.764890Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"smard_national = pd.DataFrame({\n    tech: pd.read_parquet(hub_file(\"smard\", f\"capacity_{tech}.parquet\")).resample(\"YE\").last().iloc[:, 0]\n    for tech in TECHNOLOGIES\n})\nsmard_national.index = smard_national.index.year\nsmard_national.tail()","key":"rDtYCeKvJz"},{"type":"outputs","id":"uIRO_3pyxSPMS51nRvKMr","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":3,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>solar</th>\n      <th>wind_onshore</th>\n      <th>wind_offshore</th>\n    </tr>\n    <tr>\n      <th>timestamp</th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>2022</th>\n      <td>63066.0</td>\n      <td>57590.0</td>\n      <td>8129.0</td>\n    </tr>\n    <tr>\n      <th>2023</th>\n      <td>76601.0</td>\n      <td>59841.0</td>\n      <td>8456.0</td>\n    </tr>\n    <tr>\n      <th>2024</th>\n      <td>86408.0</td>\n      <td>63192.0</td>\n      <td>9215.0</td>\n    </tr>\n    <tr>\n      <th>2025</th>\n      <td>103260.0</td>\n      <td>67693.0</td>\n      <td>9226.0</td>\n    </tr>\n    <tr>\n      <th>2026</th>\n      <td>103260.0</td>\n      <td>67693.0</td>\n      <td>9226.0</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/plain":{"content":"              solar  wind_onshore  wind_offshore\ntimestamp                                       \n2022        63066.0       57590.0         8129.0\n2023        76601.0       59841.0         8456.0\n2024        86408.0       63192.0         9215.0\n2025       103260.0       67693.0         9226.0\n2026       103260.0       67693.0         9226.0","content_type":"text/plain"}}},"children":[],"key":"FejdSUY0zN"}],"key":"IwZbABAaE4"}],"identifier":"7d4ec50f","html_id":"7d4ec50f","key":"n7V2UxwNIa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Current installed capacity","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zUBLBQw2VF"}],"identifier":"current-installed-capacity","label":"Current installed capacity","html_id":"current-installed-capacity","implicit":true,"key":"xPfOv4MCHw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Where things stand ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FTbVsxOqxn"},{"type":"emphasis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"right now","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ERfDR9BgHF"}],"key":"gopXKrdOf7"},{"type":"text","value":": MaStR’s live snapshot next to SMARD’s most\nrecently published figure. These two are ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xqMEJPe6Ml"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"not","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YgRWKkbPye"}],"key":"uHJxn81gtU"},{"type":"text","value":" a like-for-like\ncomparison -- SMARD only updates a handful of times a year, so its number\ncan lag today’s real installed capacity by close to a year. This section\nanswers “how much is installed today”, not “do the two sources agree”\n(that’s the next section, restricted to a year both sides have actually\nreported).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wSs3qdyWTw"}],"key":"YawveT3SmS"}],"identifier":"e4169bdf","html_id":"e4169bdf","key":"qDQWvGj53c"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T04:41:46.767521Z","iopub.status.busy":"2026-09-24T04:41:46.767363Z","iopub.status.idle":"2026-09-24T04:41:46.791417Z","shell.execute_reply":"2026-09-24T04:41:46.790297Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"today = pd.Timestamp.today()\nsmard_last_change = {}\nsmard_last_value = {}\nfor tech in TECHNOLOGIES:\n    raw = pd.read_parquet(hub_file(\"smard\", f\"capacity_{tech}.parquet\")).iloc[:, 0]\n    changes = raw[raw.diff().ne(0)]\n    smard_last_change[tech] = changes.index[-1].date()\n    smard_last_value[tech] = changes.iloc[-1]\n\ncurrent = pd.DataFrame({\n    \"mastr_mw_today\": mastr_national.iloc[-1],\n    \"smard_mw_last_published\": pd.Series(smard_last_value),\n    \"smard_last_updated\": pd.Series(smard_last_change),\n})\nprint(f\"MaStR as of {today.date()} vs. SMARD's own last real update per technology:\")\nprint(current)","key":"P7xYCETHO5"},{"type":"outputs","id":"l0BESdOnxZLiAPV0MeaMv","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"MaStR as of 2026-09-24 vs. SMARD's own last real update per technology:\n               mastr_mw_today  smard_mw_last_published smard_last_updated\nsolar           111491.319665                 103260.0         2025-12-31\nwind_onshore     69757.710017                  67693.0         2025-12-31\nwind_offshore    10855.643000                   9226.0         2025-12-31\n"},"children":[],"key":"c6LpFRVxfo"}],"key":"rdeiW3yGR1"}],"identifier":"6788054e","html_id":"6788054e","key":"Xy1RTmddrP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Evolution over time","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NhIHPoobln"}],"identifier":"evolution-over-time","label":"Evolution over time","html_id":"evolution-over-time","implicit":true,"key":"ycAfhG12dg"}],"identifier":"bf2a128d","html_id":"bf2a128d","key":"UQaSrcX2gL"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T04:41:46.793903Z","iopub.status.busy":"2026-09-24T04:41:46.793529Z","iopub.status.idle":"2026-09-24T04:41:47.147617Z","shell.execute_reply":"2026-09-24T04:41:47.146580Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 3, figsize=(15, 5), sharex=True)\nfor ax, tech in zip(axes, TECHNOLOGIES):\n    ax.plot(mastr_national.index, mastr_national[tech], marker=\"o\", label=\"MaStR\", color=TECHNOLOGY_COLORS[tech])\n    ax.plot(smard_national.index, smard_national[tech], marker=\"s\", linestyle=\"--\", label=\"SMARD\", color=\"#444444\")\n    ax.set_title(TECHNOLOGY_LABELS[tech])\n    ax.set_xlabel(\"Year\")\n    ax.spines[[\"top\", \"right\"]].set_visible(False)\naxes[0].set_ylabel(\"Installed capacity (MW)\")\naxes[0].legend(loc=\"upper left\", frameon=False)\nfig.suptitle(\"MaStR vs. SMARD installed capacity, full history\")\nfig.tight_layout()\nplt.show()","key":"cCyoRtTPQF"},{"type":"outputs","id":"i-DpFBIFhpUAFH6T63PK0","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"69011076cbbc1bd053f7322a459983ee","path":"/energy-insights/build/69011076cbbc1bd053f7322a459983ee.png"},"text/plain":{"content":"<Figure size 1500x500 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"GlkoAERYpM"}],"key":"fYcX8omN05"}],"identifier":"2b498b64","html_id":"2b498b64","key":"rBVeewKUmt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"MaStR’s line runs one point further right than SMARD’s -- that’s the\ncurrent, still-incomplete year discussed above, not a data problem.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zKNeWKyLdW"}],"key":"zTJz1LEPO5"}],"identifier":"3a6d06d1","html_id":"3a6d06d1","key":"bAesdjRPxX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Do the two sources agree? (latest fully completed year)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cCYgW9mYrp"}],"identifier":"do-the-two-sources-agree-latest-fully-completed-year","label":"Do the two sources agree? (latest fully completed year)","html_id":"do-the-two-sources-agree-latest-fully-completed-year","implicit":true,"key":"QmixhHGjNC"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The current year is excluded here: MaStR’s snapshot for it means\n“capacity as of today”, while SMARD’s own figure for it is just last\nyear’s number carried forward until they publish a real update --\nincluding it would make MaStR look artificially ahead by however many\nmonths have elapsed this year, not because it actually is.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vC0uV7SSly"}],"key":"IcFhtpwsVz"}],"identifier":"82e05c35","html_id":"82e05c35","key":"yZ9GCtPnsP"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T04:41:47.149656Z","iopub.status.busy":"2026-09-24T04:41:47.149484Z","iopub.status.idle":"2026-09-24T04:41:47.157669Z","shell.execute_reply":"2026-09-24T04:41:47.157005Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"current_year = today.year\ncommon_years = mastr_national.index.intersection(smard_national.index)\ncompleted_years = common_years[common_years < current_year]\n\nlatest_completed_year = completed_years.max()\ncomparison = pd.DataFrame({\n    \"mastr_mw\": mastr_national.loc[latest_completed_year],\n    \"smard_mw\": smard_national.loc[latest_completed_year],\n})\ncomparison[\"diff_mw\"] = comparison[\"mastr_mw\"] - comparison[\"smard_mw\"]\ncomparison[\"diff_pct\"] = 100 * comparison[\"diff_mw\"] / comparison[\"smard_mw\"]\nprint(f\"Year: {latest_completed_year}\")\nprint(comparison.round(1))","key":"XGSmLOlMjF"},{"type":"outputs","id":"YIh3ZVeZjrZ1mdJJAK-5o","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Year: 2025\n               mastr_mw  smard_mw  diff_mw  diff_pct\nsolar          104702.7  103260.0   1442.7       1.4\nwind_onshore    67717.7   67693.0     24.7       0.0\nwind_offshore    9733.5    9226.0    507.5       5.5\n"},"children":[],"key":"w22DzZwqXJ"}],"key":"zl8qffU2pQ"}],"identifier":"b638c8f0","html_id":"b638c8f0","key":"q9WOWe8Q57"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Onshore and offshore wind typically match SMARD closely (within a few\npercent). Solar’s match varies more year to year -- a known\ncharacteristic of MaStR rather than a data-pipeline bug: it’s a\nself-reported registry, and small rooftop PV systems in particular are\noften registered with a lag of months, so the most recent year is always\nsomewhat under- or overcounted until later backfilling catches up (see\nthe ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CpX7MsYkvK"},{"type":"cite","url":"https://doi.org/10.1145/3717413.3717421","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"open-mastr data quality paper","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UBZp0t9oIa"}],"kind":"narrative","label":"Kotthoff_2024","identifier":"https://doi.org/10.1145/3717413.3717421","enumerator":"1","key":"tMee7U77ko"},{"type":"text","value":"\nreferenced in its docs).","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kuKPaviGgE"}],"key":"foFzn5Bmfd"}],"identifier":"b8ae98d2","html_id":"b8ae98d2","key":"uKAb9OBSKL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Full history, side by side","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AWXrsMEVZh"}],"identifier":"full-history-side-by-side","label":"Full history, side by side","html_id":"full-history-side-by-side","implicit":true,"key":"IyIY3Mj6So"}],"identifier":"eb53f3da","html_id":"eb53f3da","key":"OVB1Ekn49K"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T04:41:47.159937Z","iopub.status.busy":"2026-09-24T04:41:47.159720Z","iopub.status.idle":"2026-09-24T04:41:47.176769Z","shell.execute_reply":"2026-09-24T04:41:47.175777Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"full_comparison = pd.concat(\n    {tech: pd.DataFrame({\"mastr_mw\": mastr_national.loc[completed_years, tech], \"smard_mw\": smard_national.loc[completed_years, tech]}) for tech in TECHNOLOGIES},\n    axis=1,\n)\nfull_comparison.round(0)","key":"W