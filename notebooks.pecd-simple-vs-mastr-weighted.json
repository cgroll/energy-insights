omplex_.rename(\"complex\")], axis=1, sort=False).dropna()\n    monthly = df.resample(\"MS\").mean()\n    ax.plot(monthly.index, monthly[\"complex\"], label=\"MaStR-weighted (de_capacity_factor_current_fleet)\", color=COMPLEX_COLOR, linewidth=1.3)\n    ax.plot(monthly.index, monthly[\"simple\"], label=\"Simple (fixed weights, no MaStR)\", color=SIMPLE_COLOR, linewidth=1.3, linestyle=\"--\")\n    ax.set_ylabel(\"Capacity factor\")\n    ax.set_title(tech)\n    ax.legend(loc=\"upper left\", fontsize=8)\nfig.suptitle(\"DE capacity factor, monthly mean: simple vs. MaStR-weighted\")\nfig.tight_layout()\nplt.show()","key":"dFovc0lIol"},{"type":"outputs","id":"EdJigIDy_QdePBaFg9F8Y","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"0350eca7f99b4c1e5e840f8468bbb5fe","path":"/energy-insights/build/0350eca7f99b4c1e5e840f8468bbb5fe.png"},"text/plain":{"content":"<Figure size 1300x1100 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"At9G5om5n8"}],"key":"sbWkg3Q4o8"}],"identifier":"7dde9092","html_id":"7dde9092","key":"X7qhXwXcSB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Annual mean, per technology","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ixnDQoRHG6"}],"identifier":"annual-mean-per-technology","label":"Annual mean, per technology","html_id":"annual-mean-per-technology","implicit":true,"key":"LszcfU6Gw7"}],"identifier":"2fe34aba","html_id":"2fe34aba","key":"YJKlaqDsUc"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T16:00:46.970133Z","iopub.status.busy":"2026-09-24T16:00:46.969803Z","iopub.status.idle":"2026-09-24T16:00:47.341260Z","shell.execute_reply":"2026-09-24T16:00:47.340641Z"}},"children":[{"type":"code","lang":"python","executable":t