omparison","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GcMnFM13tA"}],"identifier":"headline-comparison","label":"Headline comparison","html_id":"headline-comparison","implicit":true,"key":"Pq7fpvY0Yz"}],"identifier":"bd3a87a9","html_id":"bd3a87a9","key":"brjdondIaI"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T06:31:58.606698Z","iopub.status.busy":"2026-09-24T06:31:58.606445Z","iopub.status.idle":"2026-09-24T06:31:58.613795Z","shell.execute_reply":"2026-09-24T06:31:58.613127Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def error_stats(frame: pd.DataFrame) -> dict:\n    err = frame[\"naive\"] - frame[\"weighted\"]\n    return {\n        \"n_hours\": len(frame),\n        \"corr\": frame[\"naive\"].corr(frame[\"weighted\"]),\n        \"bias_pp\": err.mean() * 100,\n        \"mae_pp\": err.abs().mean() * 100,\n        \"rmse_pp\": (err**2).mean() ** 0.5 * 100,\n    }\n\n\nprint(pd.Series(error_stats(df)).round(4))","key":"PBNvHxUOAf"},{"type":"outputs","id":"BfHODgg_oybohoxxgs9qh","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"n_hours    96432.0000\ncorr           0.9698\nbias_pp        0.3505\nmae_pp         3.4778\nrmse_pp        4.8255\ndtype: float64\n"},"children":[],"key":"IDVNBChSej"}],"key":"v2AqRPRDWq"}],"identifier":"03bb8a14","html_id":"03bb8a14","key":"UtS2S10nv3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Monthly capacity factor, full history","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RrpFbUs4sO"}],"identifier":"monthly-capacity-factor-full-history","label":"Monthly capacity factor, full history","html_id":"monthly-capacity-factor-full-history","implicit":true,"key":"Mg2Jmag7hS"}],"identifier":"d2c43ea9","html_id":"d2c43ea