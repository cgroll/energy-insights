hon","executable":true,"value":"pct = np.linspace(0, 100, 251)\nnaive_sorted = np.percentile(df[\"naive\"].to_numpy(), 100 - pct)\nweighted_sorted = np.percentile(df[\"weighted\"].to_numpy(), 100 - pct)\n\nfig, ax = plt.subplots(figsize=(9, 4.5))\nax.plot(pct, weighted_sorted, label=\"Fleet-weighted (this hub, MaStR)\", color=WEIGHTED_COLOR, linewidth=1.5)\nax.plot(pct, naive_sorted, label=\"Naive country mean (PECD's own nuts_0 method)\", color=NAIVE_COLOR, linewidth=1.5, linestyle=\"--\")\nax.set_xlabel(\"% of hours >= this value\")\nax.set_ylabel(\"Capacity factor\")\nax.set_title(\"Load duration curve, all hours\")\nax.legend()\nfig.tight_layout()\nplt.show()","key":"owAEnJKS5E"},{"type":"outputs","id":"1ofOJk1H3FBt9ZfDxjDyD","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4e6a6bfb473cba860d43b529d1ebd8f7","path":"/energy-insights/build/4e6a6bfb473cba860d43b529d1ebd8f7.png"},"text/plain":{"content":"<Figure size 900x450 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"FPnzlt8MBr"}],"key":"kBZh5BeafE"}],"identifier":"ff18bebd","html_id":"ff18bebd","key":"hfbrJywNiH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Takeaways","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZlzZsgPKdH"}],"identifier":"takeaways","label":"Takeaways","html_id":"takeaways","implicit":true,"key":"EWMk65rjFi"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Correlation is ~0.97 at hourly resolution -- both series are driven by\nthe same underlying PECD zone-l