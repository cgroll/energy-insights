ang":"python","executable":true,"value":"rebap = pd.read_parquet(hub_file(\"balancing_market\", \"rebap_price.parquet\"))\nrebap.index = pd.to_datetime(rebap.index)\n\nnrv = pd.read_parquet(hub_file(\"balancing_market\", \"nrv_saldo.parquet\"))\nnrv.index = pd.to_datetime(nrv.index)\n\nmodules = pd.read_parquet(hub_file(\"balancing_market\", \"aep_modules.parquet\"))\nmodules.index = pd.to_datetime(modules.index)\n\npanel = pd.DataFrame({\n    \"rebap\": rebap[\"rebap_eur_mwh\"],\n    \"nrv_saldo_mw\": nrv[\"nrv_saldo_mw\"],\n    \"module1\": modules[\"aep_module1_eur_mwh\"],\n    \"module2\": modules[\"aep_module2_eur_mwh\"],\n    \"module3\": modules[\"aep_module3_eur_mwh\"],\n}).dropna(subset=[\"rebap\", \"nrv_saldo_mw\", \"module1\", \"module2\"])  # module3 allowed NaN -- \"doesn't apply\" is the normal case\npanel[\"balance_gcc_mwh\"] = panel[\"nrv_saldo_mw\"] * 0.25\n\nprint(f\"{len(panel):,} quarter-hours, {panel.index.min()} -> {panel.index.max()}\")\nprint(f\"Module 3 genuinely active: {panel['module3'].notna().mean():.2%} of quarter-hours\")","key":"dFAfNlQtXG"},{"type":"outputs","id":"mvRtDm9tMEQC0v3Pn-3G-","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"148,696 quarter-hours, 2022-06-22 00:00:00 -> 2026-09-17 21:45:00\nModule 3 genuinely active: 0.02% of quarter-hours\n"},"children":[],"key":"dpy2pIGvEG"}],"key":"v8acEAFd9x"}],"identifier":"e5b713f1","html_id":"e5b713f1","key":"Xnb0vwD28N"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"inlineCode","value":"aep_modules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HjLoST40hT"},{"type":"text","value":"’ Module 3 column already has a real raw-data quirk\ncorrected before it ever reaches this page (see the hub’s own\n","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E2Dq4tbsRx"},{"type":"inlineCode","value":"edh/aep_modules.py","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pA4Lw2r1CS"},{"type":"text","value":"): ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a0OOcygHsc"},{"type":"link","url":"http://netztransparenz.de","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"netztransparenz.de","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i4QlfzMk9u"}],"urlSource":"http://netztransparenz.de","key":"KpIitySHd0"},{"type":"text","value":" encodes “Module 3 doesn’t\napply” as a literal ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xUY78MRDtC"},{"type":"inlineCode","value":"0.0","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TSin06ahR5"},{"type":"text","value":" 99.93% of the time, not the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"y9qRSFF39v"},{"type":"inlineCode","value":"N.E.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"M2V2ArnvyM"},{"type":"text","value":" placeholder\nthe formula’s own wording (“the scarcity component has no effect” below\nthreshold) would suggest -- treating that zero as a real candidate value\nwould make it win nearly every ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kcQdwr81RI"},{"type":"inlineCode","value":"min()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nsEP8AvEF1"},{"type":"text","value":" comparison on an over-supplied\nquarter-hour, dragging a naive reconstruction toward 0 whenever Module 1\nor 2 actually set the price. Confirmed empirically while finding this:\nit dropped an earlier, uncorrected version of this reconstruction’s match\nrate from 99.99% to 89.6%.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ijvKCD2enB"}],"key":"g41UHkqJf