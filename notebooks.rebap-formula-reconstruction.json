baf7a\"  # slot 3 (aqua)\nMODULE3_COLOR = \"#eda100\"  # slot 4 (yellow)\nNEUTRAL = \"#9a9990\"","key":"FQktezTbRz"},{"type":"outputs","id":"dDnQOVJaBN5y5E94eYXRH","children":[],"key":"LdGC6ZnNRY"}],"identifier":"630a9d92","html_id":"630a9d92","key":"mTCmm2UN0e"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GZDFWYrbSG"}],"identifier":"data","label":"Data","html_id":"data","implicit":true,"key":"red4fiJoUb"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"From 2022-06-22 onward -- the AEP-Module series’ own start (reBAP and\nNRV-Saldo both go back to 2014, but the module-based calculation\nmethodology itself only took effect per a 2022-04-28 BNetzA decision).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"J0otmHAs30"}],"key":"QZ8QtJpQwi"}],"identifier":"fd80dd34","html_id":"fd80dd34","key":"AIuZdvXKRS"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-05T10:50:15.590035Z","iopub.status.busy":"2026-10-05T10:50:15.589757Z","iopub.status.idle":"2026-10-05T10:50:15.821174Z","shell.execute_reply":"2026-10-05T10:50:15.820737Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"rebap = pd.read_parquet(hub_file(\"balancing_market\", \"rebap_price.parquet\"))\nrebap.index = pd.to_datetime(rebap.index)\n\nnrv = pd.read_parquet(hub_file(\"balancing_market\", \"nrv_saldo.parquet\"))\nnrv.index = pd.to_datetime(nrv.index)\n\nmodules = pd.read_parquet(hub_file(\"balancing_market\", \"aep_modules.parquet\"))\nmodules.index = pd.to_datetime(modules.index)\n\npanel = pd.DataFrame({\n    \"rebap\": rebap[\"rebap_eur_mwh\"],\n    \"nrv_saldo_mw\": nrv[\"nrv_saldo_mw\"],\n    \"module1\": modules[\"aep_module1_eur_mwh\"],\n    \"module2\": modules[\"aep_module2_eur_mwh\"],\n    \"module3\": modules[\"aep_module3_eur_mwh\"],\n}).dropna(subset=[\"rebap\", \"nrv_saldo_mw\", \"module1\", \"module2\"])  # module3 allowed NaN -- \"doesn't apply\" is the normal case\npanel[\"balance_gcc_mwh\"] = panel[\"nrv_saldo_mw\"] * 0.25\n\nprint(f\"{len(panel):,} quarter-hours, {panel.index.min()} -> {panel.index.max()}\")\nprint(f\"Module 3 genuinely active: {panel['module3'].notna().mean():.2%} of quarter-hours\")","key":"qq0j9VldJN"},{"type":"outputs","id":"Dz66XqrSdc21pwpkBhDZh","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"148,696 quarter-hours, 2022-06-22 00:00:00 -> 2026-09-17 21:45:00\nModule 3 genuinely active: 0.02% of quarter-hours\n"},"children":[],"key":"sIRP6H6z9N"}],"key":"sXlqenTAiE"}],"identifier":"5c7ede7b","html_id":"5c7ede7b","key":"Yd05bWAJY6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"inlineCode","value":"aep_modules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b3IHzVBPHa"},{"type":"text","value":"’ Module 3 column already has a real raw-data quirk\ncorrected before it ever reaches this page (see the hub’s own\n","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R8I71QeKNV"},{"type":"inlineCode","value":"edh/aep_modules.py","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iMkEUjzoQS"},{"type":"text","value":"): ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JylNoLsYoy"},{"type":"link","url":"http://netztransparenz.de","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"netztransparenz.de","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NxOxslWhXd"}],"urlSource":"http://netztransparenz.de","key":"KZtW7u5DoY"},{"type":"text","value":" encodes “Module 3 doesn’t\napply” as a literal ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"P9jgpuc22r"},{"type":"inlineCode","value":"0.0","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vPFoW9UGuE"},{"type":"text","value":" 99.93% of the time, not the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hV0sKUUn53"},{"type":"inlineCode","value":"N.E.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sTMX83UbeX"},{"type":"text","value":" placeholder\nthe formula’s own wording (“the scarcity component has no effect” below\nthreshold) would suggest -- treating that zero as a real candidate value\nwould make it win nearly every ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tE6fIFDLDx"},{"type":"inlineCode","value":"min()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bMFA1Mc5tj"},{"type":"text","value":" comparison on an over-supplied\nquarter-hour, dragging a naive reconstruction toward 0 whenever Module 1\nor 2 actually set the price. Confirmed empirically while finding this:\nit dropped an earlier, uncorrected version of this reconstruction’s match\nrate from 99.99% to 89.6%.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bEAnvcZDNQ"}],"key":"Gv2QSdf2vC"}],"identifier":"ef02c910","html_id":"ef02c910","key":"wnkQ4XuVVM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The reconstruction","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B69DysVgKt"}],"identifier":"the-reconstruction","label":"The reconstruction","html_id":"the-reconstruction","implicit":true,"key":"Djzd1XejRB"}],"identifier":"ebca2c1c","html_id":"ebca2c1c","key":"NFz1172IpN"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-05T10:50:15.822400Z","iopub.status.busy":"2026-10-05T10:50:15.822293Z","iopub.status.idle":"2026-10-05T10:50:15.828786Z","shell.execute_reply":"2026-10-05T10:50:15.828333Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"mstack = panel[[\"module1\", \"module2\", \"module3\"]].to_numpy()\nshort = (panel[\"balance_gcc_mwh\"] > 0).to_numpy()\nlong_ = (panel[\"balance_gcc_mwh\"] < 0).to_numpy()\n\nreconstructed = np.where(\n    short, np.nanmax(mstack, axis=1),\n    np.where(long_, np.nanmin(mstack, axis=1), panel[\"module2\"].to_numpy()),\n)\npanel[\"reconstructed\"] = reconstructed\npanel[\"diff\"] = panel[\"rebap\"] - panel[\"reconstructed\"]\n\nexact = (panel[\"diff\"].abs() < 0.02).mean()\nclose = (panel[\"diff\"].abs() < 1.00).mean()\nprint(f\"Exact match (tolerance 0.02 EUR/MWh): {exact:.2%}\")\nprint(f\"Close match (tolerance 1.00 EUR/MWh):  {close:.2%}\")","key":"TTXwbVuil3"},{"type":"outputs","id":"ExnriN0xf8NS6r7VOK8lW","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Exact match (tolerance 0.02 EUR/MWh): 99.99%\nClose match (tolerance 1.00 EUR/MWh):  100.00%\n"},"children":[],"key":"xWCx94pP1c"}],"key":"nr42rX2ozV"}],"identifier":"9427cae3","html_id":"9427cae3","key":"mcTaZBHG7g"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Actual vs. reconstructed, and which module actually sets the price","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"x8EA5fCt56"}],"identifier":"actual-vs-reconstructed-and-which-module-actually-sets-the-price","label":"Actual vs. reconstructed, and which module actually sets the price","html_id":"actual-vs-reconstructed-and-which-module-actually-sets-the-price","implicit":true,"key":"hQ5StFVHRf"}],"identifier":"f043137e","html_id":"f043137e","key":"gY71TVUozc"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-05T10:50:15.830008Z","iopub.status.busy":"2026-10-05T10:50:15.829897Z","iopub.status.idle":"2026-10-05T10:50:16.061315Z","shell.execute_reply":"2026-10-05T10:50:16.060716Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"masked_max = np.where(np.isnan(mstack), -np.inf, mstack)\nmasked_min = np.where(np.isnan(mstack), np.inf, mstack)\nwinner_code = np.where(short, np.argmax(masked_max, axis=1), np.where(long_, np.argmin(masked_min, axis=1), 1))\npanel[\"winner\"] = pd.Categorical.from_codes(winner_code, categories=[\"Module 1\", \"Module 2\", \"Module 3\"])\n\nfig, axes = plt.subplots(1, 2, figsize=(12, 5.5))\n\nax = axes[0]\nlo, hi = -300, 500\nax.hist2d(panel[\"reconstructed\"], panel[\"rebap\"], bins=100, range=[[lo, hi], [lo, hi]], cmap=\"Blues\", cmin=1)\nax.plot([lo, hi], [lo, hi], color=NEUTRAL, linewidth=0.8, linestyle=\"--\")\nax.set_xlabel(\"Reconstructed reBAP [EUR/MWh]\")\nax.set_ylabel(\"Actual reBAP [EUR/MWh]\")\nax.set_title(f\"Actual vs. reconstructed\\nexact match = {exact:.1%}\", fontsize=11)\n\nax = axes[1]\nwin_share = panel[\"winner\"].value_counts().reindex([\"Module 1\", \"Module 2\", \"Module 3\"]) / len(panel) * 100\nax.bar(win_share.index, win_share.values, color=[MODULE1_COLOR, MODULE2_COLOR, MODULE3_COLOR])\nfor i, v in enumerate(win_share.values):\n    ax.text(i, v + 0.5, f\"{v:.1f}%\", ha=\"center\", fontsize=10)\nax.set_ylabel(\"Share of quarter-hours [%]\")\nax.set_title(\"Which module actually sets reBAP\", fontsize=11)\nax.yaxis.grid(True, linewidth=0.4, alpha=0.6)\nax.set_axisbelow(True)\n\nfig.tight_layout()\nplt.show()","key":"usBXGyXgFt"},{"type":"outputs","id":"2aK_BKDkhmRve76J5ZOKV","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"6c2d6e703738b8ee05f7a29a0f