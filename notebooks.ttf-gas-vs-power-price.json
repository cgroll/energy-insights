{"version":3,"kind":"Notebook","sha256":"6819079deafc887d90c6c973410f0abbe7873295a179efa5c2f6a20ae2288747","slug":"notebooks.ttf-gas-vs-power-price","location":"/notebooks/07_ttf_gas_vs_power_price.ipynb","dependencies":[],"frontmatter":{"title":"TTF gas vs. day-ahead power price","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"jupytext":{},"authors":[{"nameParsed":{"literal":"cgroll","family":"cgroll"},"name":"cgroll","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cgroll/energy-insights","copyright":"2026","numbering":{"title":{"offset":1}},"source_url":"https://github.com/cgroll/energy-insights/blob/main/book/notebooks/07_ttf_gas_vs_power_price.ipynb","edit_url":"https://github.com/cgroll/energy-insights/edit/main/book/notebooks/07_ttf_gas_vs_power_price.ipynb","exports":[{"format":"ipynb","filename":"07_ttf_gas_vs_power_price.ipynb","url":"/energy-insights/build/07_ttf_gas_vs_power_-42fd9f5b5707cbe9438800e1bfe2bf98.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Natural gas is the marginal fuel behind a large share of German day-ahead\npower prices: gas-fired plants are frequently the price-setting unit in the\nmerit order, especially outside high-renewable-output hours. Comparing TTF\n(the European gas benchmark) against SMARD’s DE-LU day-ahead auction price\nis a first, simple check on how tightly the two actually move together --\nboth read live from ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kWJrSQLGzl"},{"type":"inlineCode","value":"energy-data-hub","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cZQx3FuBcM"},{"type":"text","value":", so this stays current automatically.","position":{"start":{"line":3,"colum