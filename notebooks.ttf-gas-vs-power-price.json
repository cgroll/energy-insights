able":true,"value":"power_hourly.tail()","key":"GxHsUsBMTB"},{"type":"outputs","id":"4KafiHFxciMxPW1v0AF1I","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>price_de_lu</th>\n    </tr>\n    <tr>\n      <th>timestamp</th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>2026-09-24 17:00:00</th>\n      <td>267.32</td>\n    </tr>\n    <tr>\n      <th>2026-09-24 18:00:00</th>\n      <td>260.00</td>\n    </tr>\n    <tr>\n      <th>2026-09-24 19:00:00</th>\n      <td>225.82</td>\n    </tr>\n    <tr>\n      <th>2026-09-24 20:00:00</th>\n      <td>204.87</td>\n    </tr>\n    <tr>\n      <th>2026-09-24 21:00:00</th>\n      <td>188.01</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/plain":{"content":"                     price_de_lu\ntimestamp                       \n2026-09-24 17:00:00       267.32\n2026-09-24 18:00:00       260.00\n2026-09-24 19:00:00       225.82\n2026-09-24 20:00:00       204.87\n2026-09-24 21:00:00       188.01","content_type":"text/plain"}}},"children":[],"key":"sLMHXWwnz0"}],"key":"JTkmeo8Uja"}],"identifier":"60fbf689","html_id":"60fbf689","key":"A4c0Ep417q"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Monthly averages","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aNh4QQqE0q"}],"identifier":"monthly-averages","label":"Monthly averages","html_id":"monthly-averages","implicit":true,"key":"mG0ff6BzEd"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"TTF is trading-day close prices, SMARD is hourly auction prices -- both\nresampled to a plain calendar-month mean. The current, still-incomplete\nmonth is dropped from both sides: including it would understate or\noverstate the month depending on how far it’s progressed, the same\nreasoning ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jCwD29JrMr"},{"type":"inlineCode","value":"02_mastr_vs_smard_capacity","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oXXEskOAGF"},{"type":"text","value":" applies to the current year.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BBxvgdOCT4"}],"key":"T02zJhkV9G"}],"identifier":"33b6c316","html_id":"33b6c316","key":"KyU5ATsMJY"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T14:03:56.763217Z","iopub.status.busy":"2026-09-24T14:03:56.763111Z","iopub.status.idle":"2026-09-24T14:03:56.773046Z","shell.execute_reply":"2026-09-24T14:03:56.772247Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"current_month = pd.Timestamp.today().to_period(\"M\")\n\ngas_monthly = gas_daily[\"close\"].resample(\"MS\").mean()\ngas_monthly = gas_monthly[gas_monthly.index.to_period(\"M\") < current_month]\n\npower_monthly = power_hourly[\"price_de_lu\"].resample(\"MS\").mean()\npower_monthly = power_monthly[power_monthly.index.to_period(\"M\") < current_month]\n\nmonthly = pd.DataFrame({\"ttf_gas_eur_mwh\": gas_monthly, \"power_de_lu_eur_mwh\": power_monthly}).dropna()\nmonthly.tail()","key":"iUBcu6D689"},{"type":"outputs","id":"nOKDzhU8Sgw7n84R0aI7z","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":3,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>ttf_gas_eur_mwh</th>\n      <th>power_de_lu_eur_mwh</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>2026-04-01</th>\n      <td>44.978047</td>\n      <td>78.426333</td>\n    </tr>\n    <tr>\n      <th>2026-05-01</th>\n      <td>47.324450</td>\n      <td>97.615793</td>\n    </tr>\n    <tr>\n      <th>2026-06-01</th>\n      <td>45.072285</td>\n      <td>109.580403</td>\n    </tr>\n    <tr>\n      <th>2026-07-01</th>\n      <td>54.369272</td>\n      <td>105.470067</td>\n    </tr>\n    <tr>\n      <th>2026-08-01</th>\n      <td>62.137238</td>\n      <td>126.853414</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/plain":{"content":"            ttf_gas_eur_mwh  power_de_lu_eur_mwh\n2026-04-01        44.978047            78.426333\n2026-05-01        47.324450            97.615793\n2026-06-01        45.072285           109.580403\n2026-07-01        54.369272           105.470067\n2026-08-01        62.137238           126.853414","content_type":"text/plain"}}},"children":[],"key":"wSss9KdybN"}],"key":"OArmIDPoFo"}],"identifier":"4e8dfadb","html_id":"4e8dfadb","key":"lLCfCl1EG9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Full history, side by side","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qWVuDMWQUf"}],"identifier":"full-history-side-by-side","label":"Full history, side by side","html_id":"full-history-side-by-side","implicit":true,"key":"gmjsZOy44Z"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"One shared EUR/MWh axis -- both series are directly comparable in level,\nnot just in shape.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"t1f6LsZc5J"}],"key":"WpvH4YaNHY"}],"identifier":"6ff910ce","html_id":"6ff910ce","key":"w5PTpMSXee"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T14:03:56.774056Z","iopub.status.busy":"2026-09-24T14:03:56.773952Z","iopub.status.idle":"2026-09-24T14:03:56.899409Z","shell.execute_reply":"2026-09-24T14:03:56.898680Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(12, 5))\nax.plot(monthly.index, monthly[\"ttf_gas_eur_mwh\"], color=GAS_COLOR, linewidth=2, label=\"TTF gas\")\nax.plot(monthly.index, monthly[\"power_de_lu_eur_mwh\"], color=POWER_COLOR, linewidth=2, label=\"Power (DE-LU day-ahead)\")\nax.set_ylabel(\"EUR/MWh\")\nax.set_xlabel(\"Month\")\nax.spines[[\"top\", \"right\"]].set_visible(False)\nax.legend(loc=\"upper left\", frameon=False)\nfig.suptitle(\"Monthly average TTF gas vs. DE-LU day-ahead power price\")\nfig.tight_layout()\nplt.show()","key":"ZHbj4WfmjX"},{"type":"outputs","id":"DPCUxISUMtt_G0YJxw50C","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"90dfc3857ebcab702f15dbe5f63b6f00","path":"/energy-insights/build/90dfc3857ebcab702f15dbe5f63b6f00.png"},"text/plain":{"content":"<Figure size 1200x500 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"gOhA8VamqW"}],"key":"XI9RcltBEJ"}],"identifier":"bc85b0aa","html_id":"bc85b0aa","key":"dMZqZcGqdk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The 2021-2022 gas crisis stands out clearly on both series -- power prices\ntracked gas upward almost one-for-one at the time, consistent with gas\nbeing the marginal price setter through most of that period.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lbH9NjDz9M"}],"key":"Yq4OZ1c2yn"}],"identifier":"9d9c8968","html_id":"9d9c8968","key":"FbOXlzPUGs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Do the two move together?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WxuusWimE9"}],"identifier":"do-the-two-move-together","label":"Do the two move together?","html_id":"do-the-two-move-together","implicit":true,"key":"gzW8Sur2KM"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"A scatter of the same monthly pairs, plus their Pearson correlation --\na single overlay chart can look correlated just from both series trending\nin the same direction over a few big episodes (like 2021-2022 above); the\ncorrelation coefficient and the point cloud’s scatter around a line are a\nmore direct read on how tight the relationship actually is month to month.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PSSBi2aDdh"}],"key":"kNpNs1rOaI"}],"identifier":"1730941b","html_id":"1730941b","key":"fS3EAwoF9n"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T14:03:56.900780Z","iopub.status.busy":"2026-09-24T14:03:56.900663Z","iopub.status.idle":"2026-09-24T14:03:56.972216Z","shell.execute_reply":"2026-09-24T14:03:56.971714Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"correlation = monthly[\"ttf_gas_eur_mwh\"].corr(monthly[\"power_de_lu_eur_mwh\"])\n\nfig, ax = plt.subplots(figsize=(6, 6))\nax.scatter(monthly[\"ttf_gas_eur_mwh\"], monthly[\"power_de_lu_eur_mwh\"], color=GAS_COLOR, s=28, alpha=0.75, edgecolors=\"none\")\nax.set_xlabel(\"TTF gas (EUR/MWh, monthly avg.)\")\nax.set_ylabel(\"Power, DE-LU day-ahead (EUR/MWh, monthly avg.)\")\nax.spines[[\"top\", \"right\"]].set_visible(False)\nfig.suptitle(f\"Monthly gas vs. power price (Pearson r = {correlation:.2f})\")\nfig.tight_layout()\nplt.show()\n\nprint(f\"Pearson correlation, monthly averages: {correlation:.2f}\")\nprint(f\"Months compared: {len(monthly)} ({monthly.index.min().date()} to {monthly.index.max().date()})\")","key":"KPxojAXPL0"},{"type":"outputs","id":"U-GYEH0STQbhJEythaXgd","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5f57ac1f88ec0c96f17f95b2e878b99f","path":"/energy-insights/build/5f57ac1f88ec0c96f17f95b2e878b99f.png"},"text/plain":{"content":"<Figure size 600x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"OJ418am6J2"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Pearson correlation, monthly averages: 0.97\nMonths compared: 96 (2018-09-01 to 2026-08-01)\n"},"children":[],"key":"pFWKvsg2ny"}],"key":"SIVVmAR6lC"}],"identifier":"9bea0a15","html_id":"9bea0a15","key":"On5JlxXto9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Spread over time","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"X5qZnUepo3"}],"identifier":"spread-over-time","label":"Spread over time","html_id":"spread-over-time","implicit":true,"key":"EObCSVLOrz"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"inlineCode","value":"power - gas","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dAgIy5y135"},{"type":"text","value":", in EUR/MWh -- both being in the same unit makes this\ndifference directly meaningful, not just a shape comparison. A widening\nspread points at periods where something other than gas is driving power\nprices (e.g. carbon prices, scarcity premia, or renewable-output effects\npulling the marginal price setter away from gas); a spread near zero is\nconsistent with gas-fired plants setting the day-ahead price close to\ntheir own fuel cost.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZHThKeRB2W"}],"key":"kLKcqUzBjU"}],"identifier":"f7fbc890","html_id":"f7fbc890","key":"o1l5uO6A8q"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-24T14:03:56.973662Z","iopub.status.busy":"2026-09-24T14:03:56.973525Z","iopub.status.idle":"2026-09-24T14:03:57.060639Z","shell.execute_reply":"2026-09-24T14:03:57.060151Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"spread = monthly[\"power_de_lu_eur_mwh\"] - monthly[\"ttf_gas_eur_mwh\"]\n\nfig, ax = plt.subplots(figsize=(12, 4))\nax.axhline(0, color=\"#9a9990\", linewidth=1)\nax.plot(spread.index, spread, color=POWER_COLOR, linewidth=2)\nax.set_ylabel(\"Power - gas (EUR/MWh)\")\nax.set_xlabel(\"Month\")\nax.spines[[\"top\", \"right\"]].set_visible(False)\nfig.suptitle(\"Power-minus-gas spread, monthly average\")\nfig.tight_layout()\nplt.show()\n\nspread.describe().round(1)","key":"nIkwrq8cNd"},{"type":"outputs","id":"u8QHtItOdEWTy4AWG057F","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b0aa6c1aabedd81906ec54a4cef4f1e6","path":"/energy-insights/build/b0aa6c1aabedd81906ec54a4cef4f1e6.png"},"text/plain":{"content":"<Figure size 1200x400 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"AyYDqlkNkQ"},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":6,"metadata":{},"data":{"text/plain":{"content":"count     96.0\nmean      49.2\nstd       33.3\nmin       10.4\n25%       27.5\n50%       43.2\n75%       61.7\nmax      2